# ── HeroSection Model ──
msgid "Hero Section"
msgstr "Bosh sahifa"

msgid "Hero Sections"
msgstr "Bosh sahifalar"

msgid "Main headline text shown at the top of the homepage, e.g. 'Your Perfect Smile Starts Here'"
msgstr "Bosh sahifaning yuqori qismida ko'rsatiladigan asosiy sarlavha"

msgid "Subtitle or description text displayed below the main headline"
msgstr "Asosiy sarlavha ostida ko'rsatiladigan qo'shimcha matn"

msgid "Background image for the hero section. Recommended size: 1200x800px"
msgstr "Bosh sahifa fon rasmi. Tavsiya etilgan o'lcham: 1200x800px"

msgid "Text displayed on the call-to-action button, e.g. 'Book Appointment'"
msgstr "Tugmada ko'rsatiladigan matn, masalan: 'Qabulga yozilish'"

msgid "URL the button links to. Leave as '#' to open the booking modal"
msgstr "Tugma havola qiladigan URL. '#' qoldirsangiz booking oynasi ochiladi"

msgid "Check to display this hero section on the website. Uncheck to hide it."
msgstr "Veb-saytda ko'rsatish uchun belgilang. Yashirish uchun belgini olib tashlang."

# ── Service Model ──
msgid "Service"
msgstr "Xizmat"

msgid "Services"
msgstr "Xizmatlar"

msgid "Service name as it appears on the website, e.g. 'General Dentistry'"
msgstr "Veb-saytda ko'rsatiladigan xizmat nomi, masalan: 'Umumiy stomatologiya'"

msgid "Short description of the service shown on the service card"
msgstr "Xizmat kartasida ko'rsatiladigan qisqa tavsif"

msgid "Icon image for the service card. If left empty, a default tooth icon is shown."
msgstr "Xizmat kartasi uchun belgi rasmi. Bo'sh qoldirilsa, standart tish belgisi ko'rsatiladi."

msgid "Display order — lower numbers appear first on the website (e.g. 1, 2, 3)"
msgstr "Ko'rsatish tartibi — kichik raqamlar veb-saytda birinchi bo'lib ko'rinadi (masalan: 1, 2, 3)"

msgid "Uncheck to hide this service from the website without deleting it"
msgstr "Veb-saytdan yashirish uchun belgini olib tashlang (o'chirmasdan)"

# ── Doctor Model ──
msgid "Doctor"
msgstr "Shifokor"

msgid "Doctors"
msgstr "Shifokorlar"

msgid "Doctor's full name with title, e.g. 'Dr. James Wilson'"
msgstr "Shifokorning to'liq ismi, masalan: 'Dr. James Wilson'"

msgid "Medical specialty, e.g. 'Lead Implantologist' or 'Orthodontics Specialist'"
msgstr "Tibbiy mutaxassislik, masalan: 'Implantolog' yoki 'Ortodont'"

msgid "Short biography or description shown below the doctor's name"
msgstr "Shifokor ismi ostida ko'rsatiladigan qisqa biografiya"

msgid "Professional headshot photo of the doctor. Recommended: square image, at least 300x300px"
msgstr "Shifokorning professional rasmi. Tavsiya: kvadrat rasm, kamida 300x300px"

msgid "Number of years of professional experience, e.g. 7"
msgstr "Professional tajriba yillari soni, masalan: 7"

msgid "Uncheck to hide this doctor from the website without deleting the record"
msgstr "Veb-saytdan yashirish uchun belgini olib tashlang (yozuvni o'chirmasdan)"

# ── Testimonial Model ──
msgid "Testimonial"
msgstr "Sharh"

msgid "Testimonials"
msgstr "Sharhlar"

msgid "Patient's full name as shown in the review"
msgstr "Sharhda ko'rsatiladigan bemorning to'liq ismi"

msgid "The patient's testimonial or review text"
msgstr "Bemorning fikri yoki sharh matni"

msgid "Star rating from 1 to 5 stars given by the patient"
msgstr "Bemor tomonidan berilgan yulduzli baho (1 dan 5 gacha)"

msgid "Optional photo of the patient. Leave empty if the patient prefers anonymity."
msgstr "Bemorning ixtiyoriy rasmi. Anonimlikni afzal ko'rsa, bo'sh qoldiring."

msgid "Uncheck to hide this testimonial from the website without deleting it"
msgstr "Veb-saytdan yashirish uchun belgini olib tashlang (o'chirmasdan)"

# ── GalleryImage Model ──
msgid "Gallery Image"
msgstr "Galereya rasmi"

msgid "Gallery Images"
msgstr "Galereya rasmlari"

msgid "Gallery image file. Recommended: landscape orientation, at least 600x400px"
msgstr "Galereya rasm fayli. Tavsiya: gorizontal yo'nalish, kamida 600x400px"

msgid "Optional caption describing the image, e.g. 'Before & After: Teeth Whitening'"
msgstr "Rasmni tavsiflovchi ixtiyoriy sarlavha, masalan: 'Oldin va keyin: Tish oqartirish'"

msgid "Display order — lower numbers appear first in the gallery grid (e.g. 1, 2, 3)"
msgstr "Ko'rsatish tartibi — kichik raqamlar galereyada birinchi bo'lib ko'rinadi"

msgid "Uncheck to hide this image from the gallery without deleting it"
msgstr "Galereyadan yashirish uchun belgini olib tashlang (o'chirmasdan)"

# ── ClinicInfo Model ──
msgid "Clinic Information"
msgstr "Klinika ma'lumotlari"

msgid "Official name of the clinic, e.g. 'BrightSmile Dental'"
msgstr "Klinikning rasmiy nomi, masalan: 'BrightSmile Dental'"

msgid "Full physical address of the clinic, e.g. '123 Bright Avenue, Suite 200, New York, NY 10001'"
msgstr "Klinikning to'liq manzili"

msgid "Primary contact phone number, e.g. '(555) 123-4567'"
msgstr "Asosiy telefon raqami"

msgid "Primary contact email address, e.g. 'hello@brightsmile.com'"
msgstr "Asosiy elektron pochta manzili"

msgid "Operating hours, e.g. 'Mon–Fri: 8AM–7PM | Sat: 9AM–4PM'"
msgstr "Ish vaqti, masalan: 'Dush–Jum: 8:00–19:00 | Shan: 9:00–16:00'"

msgid "Clinic logo image displayed in the navigation bar and footer. Recommended: transparent PNG, 200x60px"
msgstr "Navigatsiya paneli va footerda ko'rsatiladigan klinika logotipi. Tavsiya: shaffof PNG, 200x60px"

msgid "Full URL to the clinic's Facebook page. Leave empty to hide the Facebook link."
msgstr "Klinikning Facebook sahifasi URL'i. Facebook havolasini yashirish uchun bo'sh qoldiring."

msgid "Full URL to the clinic's Instagram page. Leave empty to hide the Instagram link."
msgstr "Klinikning Instagram sahifasi URL'i. Instagram havolasini yashirish uchun bo'sh qoldiring."

msgid "Full URL to the clinic's YouTube channel. Leave empty to hide the YouTube link."
msgstr "Klinikning YouTube kanali URL'i. YouTube havolasini yashirish uchun bo'sh qoldiring."

msgid "About section text describing the clinic's history, mission, and values"
msgstr "Klinika tarixi, missiyasi va qadriyatlarini tavsiflovchi matn"

msgid "Image displayed in the About section. Recommended: 800x600px"
msgstr "'Biz haqimizda' bo'limida ko'rsatiladigan rasm. Tavsiya: 800x600px"

msgid "Telegram Bot Token from @BotFather, e.g. '123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11'"
msgstr "@BotFather dan olingan Telegram Bot Token"

msgid "Telegram Group/Channel ID where notifications are sent, e.g. '-1001234567890'"
msgstr "Bildirishnomalar yuboriladigan Telegram guruh/kanal ID si"

# ── FAQ Model ──
msgid "FAQ"
msgstr "Savol-Javob"

msgid "FAQs"
msgstr "Savol-Javoblar"

msgid "The FAQ question text, e.g. 'Do you accept dental insurance?'"
msgstr "FAQ savol matni, masalan: 'Sug'urta qabul qilasizmi?'"

msgid "The detailed answer to the question"
msgstr "Savolga batafsil javob"

msgid "Uncheck to hide this FAQ from the website without deleting it"
msgstr "Veb-saytdan yashirish uchun belgini olib tashlang (o'chirmasdan)"

# ── Appointment Model ──
msgid "Appointment"
msgstr "Qabul"

msgid "Appointments"
msgstr "Qabullar"

msgid "Patient's full name as entered in the booking form"
msgstr "Bron qilish formasida kiritilgan bemorning to'liq ismi"

msgid "Patient's phone number for callback confirmation"
msgstr "Tasdiqlash uchun qayta qo'ng'iroq qilinadigan telefon raqami"

msgid "Patient's email address (optional)"
msgstr "Bemorning elektron pochta manzili (ixtiyoriy)"

msgid "The date the patient requested for their appointment"
msgstr "Bemor so'ragan qabul sanasi"

msgid "The time the patient requested, e.g. '14:00' (optional)"
msgstr "Bemor so'ragan vaqt, masalan: '14:00' (ixtiyoriy)"

msgid "The dental service the patient selected when booking"
msgstr "Bemor bron qilganda tanlagan stomatologik xizmat"

msgid "Any additional notes or comments the patient added"
msgstr "Bemor qo'shgan qo'shimcha eslatmalar yoki izohlar"

msgid "Automatically set — the date and time this appointment was submitted"
msgstr "Avtomatik o'rnatiladi — qabul yuborilgan sana va vaqt"

msgid "Check this box after you have reviewed the appointment request"
msgstr "Qabul so'rovini ko'rib chiqqaningizdan keyin ushbu katakni belgilang"

